    "fd.loc[\n",
    "    fd[\"Income/Expense\"] == \"Expense\",\n",
    "    \"Dashboard_Group\"\n",
    "] = \"Regular Expenses\"\n",
    "\n",
    "# Investment and Savings\n",
    "fd.loc[\n",
    "    (fd[\"Income/Expense\"] == \"Expense\") &\n",
    "    (fd[\"Category\"].isin([\n",
    "        \"Investment\",\n",
    "        \"Public Provident Fund\",\n",
    "        \"Recurring Deposit\"\n",
    "    ])),\n",
    "    \"Dashboard_Group\"\n",
    "] = \"Investment & Savings\"\n",
    "\n",
    "# Money Transfer (Unverified)\n",
    "fd.loc[\n",
    "    (fd[\"Income/Expense\"] == \"Expense\") &\n",
    "    (fd[\"Category\"] == \"Money transfer\"),\n",
    "    \"Dashboard_Group\"\n",
    "] = \"Money Transfer - Review\"\n",
    "\n",
    "# Transfer-Out\n",
    "fd.loc[\n",
    "    fd[\"Income/Expense\"] == \"Transfer-Out\",\n",
    "    \"Dashboard_Group\"\n",
    "] = \"Transfer-Out\"\n",
    "\n",
    "# Group-wise Financial Summary\n",
    "group_summary = fd.groupby(\"Dashboard_Group\")[\"Amount\"].agg(\n",
    "    [\"count\", \"sum\"]\n",
    ").round(2)\n",
    "\n",
    "group_summary\n"
   ]
  },
